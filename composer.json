{
    "name": "kudashevs/birthday-greetings-kata-php",
    "description": "Birthday Greetings Kata a PHP version",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.8",
        "symfony/mailer": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1|^11.0|^12.0",
        "mockery/mockery": "^1.5|^1.6",
        "symfony/process": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "BirthdayGreetings\\": "src/birthday_greetings/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BirthdayGreetings\\Tests\\": "tests/birthday_greetings/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --no-coverage",
        "test-coverage":  "vendor/bin/phpunit --coverage-html build/coverage"
    }
} 
